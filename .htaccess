<IfModule mod_rewrite.c>
    Options -Indexes

    RewriteEngine On

    RewriteRule ^(app|bootstrap|config|database|lang|resources|routes|storage|vendor|tests)(/|$) - [F,L]
    RewriteRule ^(\.env|\.env\..*|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md)$ - [F,L]
    RewriteRule ^.*\.(bak|conf|dist|ini|log|old|orig|save|sql|sqlite|swp|tmp|yml|yaml)$ - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env|\.env\..*|\.git|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|README\.md)$">
    Require all denied
</FilesMatch>
